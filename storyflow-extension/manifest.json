{
  "manifest_version": 3,
  "name": "StoryFlow – Pubblicazione automatica storie",
  "version": "3.0.0",
  "description": "StoryFlow: pubblica le storie preparate nel pannello su Meta Business Suite, con motore aggiornabile dal server.",
  "permissions": [
    "debugger",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "userScripts"
  ],
  "host_permissions": [
    "https://business.facebook.com/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "saas-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://business.facebook.com/latest/story_composer/*"
      ],
      "js": [
        "file-picker-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Connetti StoryFlow alla dashboard aperta"
  },
  "minimum_chrome_version": "120"
}
